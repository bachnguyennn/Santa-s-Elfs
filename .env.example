# SantaElf configuration. Copy to .env.local for local development.
# With NOTHING set, SantaElf runs in local demo mode:
#   - data in an embedded Postgres (PGlite) under .data/pglite
#   - emails are SIMULATED (viewable at http://localhost:3000/dev/outbox), nothing is sent

# Public base URL used in emailed links (no trailing slash)
APP_URL=http://localhost:3000

# Postgres connection string (Supabase: Project Settings -> Database -> Connection string,
# use the transaction pooler URI on port 6543 for serverless). Leave empty for local PGlite.
DATABASE_URL=

# Email via Resend (https://resend.com). Leave RESEND_API_KEY empty to simulate emails.
RESEND_API_KEY=
EMAIL_FROM="SantaElf <santa@your-verified-domain.example>"
# simulate | resend (defaults to resend when RESEND_API_KEY is set)
EMAIL_MODE=
# Daily send cap (Resend free tier: 100/day)
EMAIL_DAILY_LIMIT=100

# Shared secret for GET /api/cron/tick (scheduled draws, email retries, cleanup).
# Generate with: openssl rand -hex 32
CRON_SECRET=
